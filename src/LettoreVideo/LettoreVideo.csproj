<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The engine talks to FFmpeg, Vulkan and COM through raw pointers (no NuGet: interop is ours). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The FFmpeg DLLs are native x64 binaries: the app must never build as AnyCPU. -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>LettoreVideo</AssemblyName>
    <RootNamespace>LettoreVideo</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LettoreVideo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- FFmpeg shared build, loaded at runtime from "ffmpeg\" next to the exe
         (FFmpegLoader). Not in git: see README. -->
    <None Include="runtimes\win-x64\native\ffmpeg\*.dll">
      <Link>ffmpeg\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
