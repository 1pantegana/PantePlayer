<Window x:Class="LettoreVideo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mpv="clr-namespace:LettoreVideo.Mpv"
        Title="Lettore Video" Height="720" Width="1280"
        MinHeight="420" MinWidth="720"
        Background="#12141A" Foreground="#E8EAF0"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#181B23"/>
        <SolidColorBrush x:Key="PanelAlt" Color="#1E222C"/>
        <SolidColorBrush x:Key="Accent" Color="#76B900"/>
        <SolidColorBrush x:Key="Muted" Color="#8A90A0"/>

        <Style TargetType="Button" x:Key="Transport">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2F3C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#565C6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="300" x:Name="PlaylistColumn"/>
        </Grid.ColumnDefinitions>

        <!-- Video surface: mpv renders straight into this native child window. -->
        <Border Grid.Row="0" Grid.Column="0" Background="Black" ClipToBounds="True">
            <mpv:MpvHost x:Name="VideoHost"/>
        </Border>

        <GridSplitter Grid.Row="0" Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch" Background="#0E1015"
                      x:Name="Splitter"/>

        <!-- Playlist -->
        <Grid Grid.Row="0" Grid.Column="2" Background="{StaticResource Panel}" x:Name="PlaylistPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="14,14,14,10">
                <TextBlock Text="PLAYLIST" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Muted}"/>
                <TextBlock Text="{Binding FolderName}" FontSize="14" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <Button Content="Apri cartella…" Command="{Binding OpenFolderCommand}"
                        Margin="0,10,0,0" Padding="10,7" Cursor="Hand"
                        Background="{StaticResource PanelAlt}" Foreground="#E8EAF0"
                        BorderThickness="0"/>
            </StackPanel>

            <ListBox Grid.Row="1" x:Name="PlaylistBox"
                     ItemsSource="{Binding Playlist}"
                     SelectedIndex="{Binding CurrentIndex, Mode=OneWay}"
                     Background="Transparent" BorderThickness="0"
                     Foreground="#E8EAF0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="PlaylistBox_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="14,7"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Path}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Control bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" x:Name="ControlBar"
                Background="{StaticResource Panel}"
                BorderBrush="#0E1015" BorderThickness="0,1,0,0" Padding="14,8">
            <StackPanel>
                <!-- Seek -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PositionText}" VerticalAlignment="Center"
                               FontFamily="Consolas" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
                    <Slider Grid.Column="1" x:Name="SeekBar" VerticalAlignment="Center"
                            Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position}"
                            IsMoveToPointEnabled="True"
                            Thumb.DragStarted="SeekBar_DragStarted"
                            Thumb.DragCompleted="SeekBar_DragCompleted"/>
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center"
                               FontFamily="Consolas" Foreground="{StaticResource Muted}" Margin="10,0,0,0"/>
                </Grid>

                <!-- Buttons -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource Transport}" Content="⏮"
                                Command="{Binding PreviousCommand}" ToolTip="Precedente"/>
                        <Button Style="{StaticResource Transport}" Content="{Binding PlayPauseGlyph}"
                                Command="{Binding PlayPauseCommand}" ToolTip="Play / Pausa (Spazio)"
                                MinWidth="46"/>
                        <Button Style="{StaticResource Transport}" Content="⏭"
                                Command="{Binding NextCommand}" ToolTip="Successivo"/>

                        <TextBlock Text="🔊" VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <Slider Width="110" VerticalAlignment="Center" Minimum="0" Maximum="130"
                                Value="{Binding Volume}" ToolTip="Volume"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="18,0"
                               Text="{Binding CurrentItem.DisplayName}"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#3A4050"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VsrActive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding VsrStatus}" VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,10,0"/>

                        <ComboBox x:Name="VsrModeBox" Width="150" VerticalAlignment="Center"
                                  SelectionChanged="VsrModeBox_SelectionChanged"
                                  ToolTip="NVIDIA RTX Video Super Resolution">
                            <ComboBoxItem Content="RTX VSR: Auto &lt;1080p" IsSelected="True"/>
                            <ComboBoxItem Content="RTX VSR: sempre ON"/>
                            <ComboBoxItem Content="RTX VSR: sempre OFF"/>
                        </ComboBox>

                        <CheckBox Content="RTX HDR" VerticalAlignment="Center" Margin="10,0,0,0"
                                  IsChecked="{Binding TrueHdr}" Foreground="{StaticResource Muted}"
                                  ToolTip="RTX Video HDR — utile solo su schermo HDR"/>

                        <Button Style="{StaticResource Transport}" Content="⛶" Margin="6,0,0,0"
                                Click="Fullscreen_Click" ToolTip="Schermo intero (F11)"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
